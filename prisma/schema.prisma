// Prisma schema for proj_mana.
// This file is the source of truth for the data model (see CLAUDE.md §4).
//
// Conventions:
// - IDs are cuid()
// - Timestamps are timestamptz (stored in UTC, displayed in Asia/Tokyo)
// - Calendar dates (start / due / end) are @db.Date
// - Every foreign key is indexed

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MEMBER
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

// ---------------------------------------------------------------------------
// Users & Auth.js
// ---------------------------------------------------------------------------

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  // Required by the Auth.js Prisma Adapter.
  emailVerified     DateTime? @db.Timestamptz(3)
  name              String?
  image             String?
  role              Role      @default(MEMBER)
  // Users are never physically deleted; deactivate instead.
  isActive          Boolean   @default(true)
  emailNotification Boolean   @default(true)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  accounts        Account[]
  sessions        Session[]
  invitationsSent Invitation[] @relation("InvitationInvitedBy")
  projectsCreated Project[]    @relation("ProjectCreatedBy")
  tasksCreated    Task[]       @relation("TaskCreatedBy")
  tasksAssigned   Task[]       @relation("TaskAssignee")
  comments        Comment[]
  attachments     Attachment[]
}

// Auth.js standard model.
model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

// Auth.js standard model (database sessions).
model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Auth.js standard model.
model VerificationToken {
  identifier String
  token      String
  expires    DateTime @db.Timestamptz(3)

  @@id([identifier, token])
}

model Invitation {
  id          String    @id @default(cuid())
  email       String
  role        Role      @default(MEMBER)
  invitedById String
  expiresAt   DateTime  @db.Timestamptz(3)
  acceptedAt  DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  invitedBy User @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([email])
  @@index([invitedById])
}

// ---------------------------------------------------------------------------
// Projects & tasks
// ---------------------------------------------------------------------------

model Project {
  id          String        @id @default(cuid())
  name        String
  // Markdown
  description String?
  startDate   DateTime?     @db.Date
  endDate     DateTime?     @db.Date
  status      ProjectStatus @default(ACTIVE)
  createdById String
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)

  createdBy User   @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  tasks     Task[]

  @@index([status])
  @@index([createdById])
}

model Task {
  id          String     @id @default(cuid())
  projectId   String
  // Subtasks are one level deep only: a parent must itself have parentId = null
  // (validated on the server).
  parentId    String?
  title       String
  // Markdown
  description String?
  status      TaskStatus @default(TODO)
  assigneeId  String?
  startDate   DateTime?  @db.Date
  dueDate     DateTime?  @db.Date
  // Order within a kanban column. New positions take the midpoint of their
  // neighbours; the column is renumbered when the gap becomes too small.
  position    Float
  createdById String
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(3)

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent      Task?        @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks    Task[]       @relation("TaskSubtasks")
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy   User         @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  comments    Comment[]
  attachments Attachment[]

  // Also serves as the index for projectId.
  @@index([projectId, status, position])
  @@index([parentId])
  @@index([assigneeId])
  @@index([createdById])
  @@index([dueDate])
}

// ---------------------------------------------------------------------------
// Comments & attachments
// ---------------------------------------------------------------------------

model Comment {
  id        String    @id @default(cuid())
  taskId    String
  authorId  String
  // Markdown
  body      String
  // Soft delete
  deletedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
  @@index([authorId])
}

model Attachment {
  id           String   @id @default(cuid())
  taskId       String
  uploadedById String
  fileName     String
  contentType  String
  // Bytes
  size         Int
  // Object key in the Cloud Storage bucket.
  storageKey   String   @unique
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  task       Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([taskId])
  @@index([uploadedById])
}

// ---------------------------------------------------------------------------
// Organization settings
// ---------------------------------------------------------------------------

// Singleton row: the app is single-tenant (1 deployment = 1 organization),
// so there is always exactly one row with id = 1.
model OrgSetting {
  id              Int      @id @default(1)
  slackWebhookUrl String?
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
}
